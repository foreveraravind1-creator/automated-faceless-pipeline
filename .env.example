# Copy to .env and fill in real values locally. Never commit .env.
# Pass 1 (script stage) needs only GEMINI_API_KEY.

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Later passes. Not required to generate a script.
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=faceless-reels-public-assets
GCS_REGION=US
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
PEXELS_API_KEY=

OUTPUT_DIR=output
LOG_LEVEL=INFO
PORT=8080
