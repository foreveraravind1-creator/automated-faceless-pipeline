# Copy to .env and fill in real values locally. Never commit .env.
# Pass 1 (script stage) needs only GEMINI_API_KEY.

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Dry-run voice and stock footage. Not required to write a script.
KOKORO_VOICE=af_heart
KOKORO_LANG=a
PEXELS_API_KEY=your-pexels-api-key

# Not used by the script, render, or publish commands.
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Supervised publish only (python main.py --publish --job-id ID --confirm-publish).
# Not used by the script command, --dry-run, or the webhook.
# Placeholders only. Never commit a real token.
# Resumable upload uses graph.facebook.com (Facebook Login for Business).
GRAPH_API_VERSION=v26.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Container status poll. About once a minute, bounded total wait.
PUBLISH_POLL_INTERVAL_SECONDS=60
PUBLISH_MAX_WAIT_SECONDS=600

# Local default. The container sets this to /tmp/output.
OUTPUT_DIR=output
LOG_LEVEL=INFO
PORT=8080
