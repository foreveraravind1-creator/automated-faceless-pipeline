# Copy to .env and fill in real values locally. Never commit .env.
# Pass 1 (script stage) needs only GEMINI_API_KEY.

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Dry-run voice and stock footage. Not required to write a script.
KOKORO_VOICE=af_heart
KOKORO_LANG=a
PEXELS_API_KEY=your-pexels-api-key

# Later publish pass. Not used by the script command or --dry-run.
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=faceless-reels-public-assets
GCS_REGION=US
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Local default. The container sets this to /tmp/output.
OUTPUT_DIR=output
LOG_LEVEL=INFO
PORT=8080
